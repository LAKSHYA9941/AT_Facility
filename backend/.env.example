# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

DATABASE_URL=
DIRECT_URL=

# Server
PORT=4000
NODE_ENV=development

# Redis (paste your Upstash Redis URL)
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# MSG91 (OTP) — OPTIONAL
# If these are not set, OTPs will be logged to console instead of sent via SMS.
# Useful for local development and free-tier deployments.
MSG91_API_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Admin default credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=+919999999999

MAPPLS_REST_API_KEY=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=

GOOGLE_MAPS_API_KEY=

# Geoapify
GEOAPIFY_API_KEY=
