generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  PENDING
}

enum KYCStatus {
  UNSUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum VehicleSegment {
  HATCHBACK
  SEDAN
  MINI_SUV
  SUV
  TEMPO
}

enum TripStatus {
  PENDING_PAYMENT
  CONFIRMED
  DRIVER_ASSIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum PaymentMethod {
  UPI
  CARD
  WALLET
  CASH
}

enum PackageCategory {
  BEACH
  HILLS
  CITYBREAK
  WILD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ExtraChargeType {
  EXTRA_KM
  EXTRA_HOURS
  FUEL
  DAMAGE
  DRIVER_ADDON
  OTHER
}

enum CustomPlanStatus {
  NEW
  REVIEWED
  QUOTED
  ACCEPTED
  REJECTED
}

// ==================== CORE USER ====================

model User {
  id              String     @id @default(cuid())
  phone           String     @unique
  name            String?
  email           String?    @unique
  password        String? // only for admin accounts
  role            Role       @default(CUSTOMER)
  aadhaarNumber   String?
  aadhaarVerified Boolean    @default(false)
  profileComplete Boolean    @default(false)
  status          UserStatus @default(ACTIVE)

  refreshTokens   RefreshToken[]
  driverProfile   DriverProfile?
  packageBookings PackageBooking[]
  rentals         Rental[]
  notifications   Notification[]
  customPlans     CustomPlan[]     @relation("CustomPlans")

  // Trip relations
  tripsAsCustomer Trip[] @relation("CustomerTrips")

  // ID Verification
  idProofType   String? // AADHAAR | PAN | PASSPORT | VOTER_ID | DRIVING_LICENCE
  idProofFront  String? // S3 URL
  idProofBack   String? // S3 URL (null for single-sided docs)
  idVerified    Boolean   @default(false)
  idVerifiedAt  DateTime?
  idVerifiedBy  String? // admin userId
  idSubmittedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ==================== AUTH ====================

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  deviceName String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  revoked    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model OTP {
  id        String   @id @default(cuid())
  phone     String
  code      String // 6 digits
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0) // max 3 wrong attempts

  createdAt DateTime @default(now())

  @@index([phone])
}

// ==================== DRIVER ====================

model DriverProfile {
  id     String  @id @default(cuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String?

  rating        Float   @default(0)
  totalTrips    Int     @default(0)
  totalEarnings Float   @default(0)
  isOnline      Boolean @default(false)
  isAvailable   Boolean @default(false)
  strikes       Int     @default(0) // 3 strikes = suspension

  kycStatus KYCStatus       @default(UNSUBMITTED)
  segment   VehicleSegment?

  // Bank details for payouts
  bankAccountNumber String?
  bankIFSC          String?
  bankAccountName   String?
  bankVerified      Boolean @default(false)

  // Flat KYC Documents
  aadhaarNumber  String?
  aadhaarUrl     String?
  dlNumber       String?
  dlUrl          String?
  rcNumber       String?
  rcUrl          String?
  panNumber      String?
  panUrl         String?
  bankDetailsUrl String?
  selfieUrl      String?

  vehicle Vehicle?

  // Trip relations
  tripsAsDriver       Trip[]       @relation("DriverTrips")
  assignedCustomPlans CustomPlan[] @relation("AssignedCustomPlans")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isOnline, isAvailable, kycStatus])
}

model Vehicle {
  id       String        @id @default(cuid())
  driverId String        @unique
  driver   DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  make               String
  model              String
  color              String
  year               Int
  plateNumber        String         @unique
  registrationNumber String         @unique
  segment            VehicleSegment

  // Capacity
  maxCapacity        Int // max passengers
  perHeadExtraCharge Float @default(0) // charge if exceeded

  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?

  isAvailableForRental Boolean @default(false)
  rentalPricePerDay    Float?
  rentalKmLimit        Int? // daily km limit for rentals
  rentalExtraKmCharge  Float? // per km beyond limit

  rentals Rental[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== TRIPS ====================

model Trip {
  id       String  @id @default(uuid())
  userId   String
  driverId String?

  // Itinerary
  tripType       TripType
  status         TripStatus     @default(PENDING_PAYMENT)
  startDate      DateTime
  endDate        DateTime
  passengerCount Int
  vehicleSegment VehicleSegment

  // Financials
  totalFare         Float
  upfrontPercentage Int // 25, 50, or 100
  amountPaidUpfront Float
  balanceRemaining  Float

  // Trip OTP (generated on CONFIRMED)
  startOtp String?

  customerNotifiedAt       DateTime?
  driverAssignedNotifiedAt DateTime?
  driverNotifiedAt         DateTime?

  // Relations
  waypoints Waypoint[]
  payment   Payment?
  user      User           @relation("CustomerTrips", fields: [userId], references: [id])
  driver    DriverProfile? @relation("DriverTrips", fields: [driverId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, status])
  @@index([driverId, status])
}

model Waypoint {
  id         String @id @default(uuid())
  tripId     String
  address    String
  lat        Float
  lng        Float
  orderIndex Int // 0 = Pickup, last = Final Drop
  trip       Trip   @relation(fields: [tripId], references: [id])
}

model Payment {
  id        String          @id @default(cuid())
  tripId    String?         @unique
  trip      Trip?           @relation(fields: [tripId], references: [id])
  packageId String?         @unique
  package   PackageBooking? @relation(fields: [packageId], references: [id])
  rentalId  String?         @unique
  rental    Rental?         @relation(fields: [rentalId], references: [id])
  customPlanId String?      @unique
  customPlan   CustomPlan?  @relation(fields: [customPlanId], references: [id])

  razorpayOrderId String?
  status          String  @default("INITIATED")
  amount          Float?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  razorpayPaymentId String?  @unique
}

// ==================== PACKAGES ====================

model Package {
  id           String          @id @default(cuid())
  title        String
  subtitle     String
  description  String // full description
  category     PackageCategory
  price        Float // base price per person
  durationDays Int
  maxPeople    Int             @default(2)

  // What's covered
  inclusions String[] // "Flights", "4-star hotel", "Breakfast"
  exclusions String[] // "Visa fees", "Personal expenses"

  // Day by day plan — JSON array
  // [{ day: 1, title: "Arrival", description: "...", activities: [] }]
  itinerary Json @default("[]")

  imageUrls String[]
  isActive  Boolean  @default(true)

  bookings PackageBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])
}

model PackageBooking {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  travelDate     DateTime
  numPeople      Int
  pricePerPerson Float
  totalPrice     Float // pricePerPerson × numPeople

  // Extra people beyond maxPeople
  extraPeople       Int   @default(0)
  extraPeopleCharge Float @default(0)

  status          BookingStatus @default(PENDING)
  razorpayOrderId String?
  paymentStatus   PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Payment   Payment?

  @@index([userId])
}

// ==================== RENTALS ====================

model Rental {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  pickupLocation String
  returnLocation String
  startDate      DateTime
  endDate        DateTime
  totalDays      Int

  pricePerDay    Float
  baseTotalPrice Float // pricePerDay × totalDays — PREPAID

  // Optional driver add-on — prepaid
  withDriver        Boolean @default(false)
  driverCharge      Float   @default(0) // per day
  driverTotalCharge Float   @default(0)

  // Total prepaid amount
  prepaidAmount Float

  // Postpaid extras — filled after return
  extraCharges    RentalExtraCharge[]
  extraTotal      Float               @default(0)
  extraPaid       Boolean             @default(false)
  extraRazorpayId String?

  status          BookingStatus @default(PENDING)
  razorpayOrderId String? // prepaid order
  paymentStatus   PaymentStatus @default(PENDING)

  returnedAt  DateTime?
  returnNotes String? // admin notes on return condition

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Payment   Payment?

  @@index([userId])
}

model RentalExtraCharge {
  id       String @id @default(cuid())
  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id])

  type        ExtraChargeType
  description String // "Drove 45km extra", "Returned 2hrs late"
  amount      Float

  createdAt DateTime @default(now())
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  body      String
  data      Json? // { rideId, screen } for deep linking
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model CustomPlan {
  id              String @id @default(uuid())
  submittedBy     String
  user            User   @relation("CustomPlans", fields: [submittedBy], references: [id])
  submittedByRole Role // CUSTOMER or DRIVER — set server-side from JWT

  // Plan details
  pickupLocation     String
  pickupLat          Float?
  pickupLng          Float?
  destinations       String[] // e.g. ["Manali", "Kasol", "Kufri"]
  numberOfTravellers Int
  budgetMin          Int // INR
  budgetMax          Int // INR
  carType            VehicleSegment?
  hotelRequired      Boolean         @default(false)
  hotelType          String?         // BUDGET | STANDARD | COMFORT_SUITE | DELUXE | LUXURY
  additionalNotes    String?

  // Admin workflow
  status       CustomPlanStatus @default(NEW)
  adminNotes   String?
  reviewedBy   String? // admin userId
  reviewedAt   DateTime?
  quotedAmount Int? // INR — filled by admin

  // Payment relation
  payment Payment?

  // Driver assignment (admin sets after payment)
  assignedDriverId   String?        // driverProfile.id
  assignedDriver     DriverProfile? @relation("AssignedCustomPlans", fields: [assignedDriverId], references: [id])
  driverEarning      Int?           // INR — what the driver gets
  platformCommission Int?           // INR — what AT Facility keeps

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([submittedBy])
}
