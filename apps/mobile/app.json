{
  "expo": {
    "name": "atfacilities",
    "slug": "atfacilities",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpeg",
    "scheme": "atfacilities",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "bundler": "metro",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atfacilities.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow AT Facility to access your location to pick you up."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.jpeg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.atfacilities.app",
      "versionCode": 1,
      "navigationBar": {
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AT Facility to access your location to pick you up."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "geoapifyKey": "EXPO_PUBLIC_GEOAPIFY_KEY",
      "router": {},
      "eas": {
        "projectId": "a73880e0-7411-4371-a3f1-bceb9df0165f"
      }
    },
    "owner": "laksh28"
  }
}
